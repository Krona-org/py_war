{
    "version": 3,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Default Ninja MinGw Debug",
            "description": "Build dcseditor with Ninja and MinGW into ${sourceDir}/build_debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc"
            }
        },
        {
            "name": "release",
            "displayName": "Default Ninja MinGw Release",
            "description": "Build dcseditor with Ninja and MinGW into ${sourceDir}/build_release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "jobs": 0
        },
        {
            "name": "release",
            "configurePreset": "release",
            "jobs": 0
        }
    ]
}